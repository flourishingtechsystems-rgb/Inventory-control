DATABASE_URL="file:./dev.db"
# openssl rand -base64 32
AUTH_SECRET="change-me"
# 32-byte key (base64) used to encrypt QuickBooks/Xero OAuth tokens at rest.
# openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""
# Public URL of this app, used to build OAuth redirect URIs.
APP_URL="http://localhost:3000"
# Bearer token for the scheduled sync endpoint (POST /api/integrations/sync).
CRON_SECRET=""

# QuickBooks Online (https://developer.intuit.com) — redirect URI:
#   ${APP_URL}/api/integrations/quickbooks/callback
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
# "sandbox" or "production"
QBO_ENVIRONMENT="sandbox"

# Xero (https://developer.xero.com) — redirect URI:
#   ${APP_URL}/api/integrations/xero/callback
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# Override if your Xero app uses granular scopes.
XERO_SCOPES="openid profile email offline_access accounting.transactions accounting.contacts accounting.settings"
